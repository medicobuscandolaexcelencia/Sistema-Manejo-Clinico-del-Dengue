<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SIMAC-D · Sistema de Manejo Clínico del Dengue</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Source+Serif+4:ital,wght@0,300;0,400;0,600;1,300&display=swap" rel="stylesheet">
<style>
:root {
  --rojo:#C1121F; --rojo-vivo:#E63946; --morado:#7B2D8B; --azul:#0077B6; --azul-claro:#00B4D8; --celeste:#90E0EF;
  --naranja:#F77F00; --naranja-claro:#FCBF49; --verde:#2D6A4F; --verde-claro:#52B788;
  --gris-bg:#F0F4F8; --gris-borde:#CBD5E1; --blanco:#FFFFFF; --texto:#1E293B; --texto-suave:#64748B;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Montserrat',sans-serif;background:var(--gris-bg);color:var(--texto);min-height:100vh;}

/* ===== LOGIN ===== */
#loginScreen{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  min-height:100vh;
  background:linear-gradient(160deg,#1a0010 0%,#6B1C75 28%,#0077B6 65%,#00B4D8 100%);
  position:fixed;inset:0;z-index:9999;
}
.login-glow{
  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  width:500px;height:500px;border-radius:50%;
  background:radial-gradient(circle,rgba(123,45,139,0.3) 0%,transparent 70%);
  pointer-events:none;
}
.login-card{
  background:rgba(255,255,255,0.07);
  backdrop-filter:blur(20px);
  border:1px solid rgba(255,255,255,0.18);
  border-radius:24px;
  padding:48px 44px 40px;
  width:420px;max-width:95vw;
  box-shadow:0 32px 80px rgba(0,0,0,0.5);
  position:relative;z-index:1;
  text-align:center;
}
.login-logo{
  width:96px;height:96px;
  border-radius:50%;
  background:white;
  display:flex;align-items:center;justify-content:center;
  margin:0 auto 20px;
  box-shadow:0 8px 32px rgba(0,0,0,0.3);
  overflow:hidden;
}
.login-logo img{width:100%;height:100%;object-fit:cover;border-radius:50%;}
.login-app-name{
  font-size:2rem;font-weight:900;
  background:linear-gradient(135deg,#fff 0%,#E8A0F0 50%,#90E0EF 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  letter-spacing:2px;margin-bottom:4px;
}
.login-app-subtitle{
  font-size:0.72rem;font-weight:600;color:rgba(255,255,255,0.6);
  letter-spacing:1px;text-transform:uppercase;margin-bottom:32px;
}
.login-input-group{display:flex;flex-direction:column;gap:14px;margin-bottom:24px;}
.login-input{
  font-family:'Montserrat',sans-serif;font-size:0.88rem;
  padding:13px 16px;
  background:rgba(255,255,255,0.1);
  border:1.5px solid rgba(255,255,255,0.2);
  border-radius:10px;color:white;outline:none;
  transition:all 0.2s;
}
.login-input::placeholder{color:rgba(255,255,255,0.4);}
.login-input:focus{border-color:rgba(144,224,239,0.7);background:rgba(255,255,255,0.15);}
.login-btn{
  width:100%;padding:14px;
  background:linear-gradient(135deg,var(--rojo-vivo),var(--morado),var(--azul));
  border:none;border-radius:10px;
  font-family:'Montserrat',sans-serif;font-size:0.95rem;font-weight:700;
  color:white;cursor:pointer;letter-spacing:0.5px;
  transition:all 0.25s;box-shadow:0 4px 20px rgba(0,0,0,0.3);
}
.login-btn:hover{transform:translateY(-2px);box-shadow:0 8px 28px rgba(0,0,0,0.4);}
.login-error{
  display:none;font-size:0.78rem;color:#FF8FA3;
  background:rgba(193,18,31,0.2);border:1px solid rgba(193,18,31,0.4);
  border-radius:8px;padding:8px 12px;margin-bottom:14px;
}
.login-footer{
  margin-top:28px;border-top:1px solid rgba(255,255,255,0.1);
  padding-top:18px;
}
.login-footer-name{font-size:0.78rem;font-weight:700;color:rgba(255,255,255,0.8);}
.login-footer-sub{font-size:0.65rem;color:rgba(255,255,255,0.45);margin-top:3px;}
.login-footer-copy{
  font-size:0.62rem;color:rgba(255,255,255,0.3);
  margin-top:10px;letter-spacing:0.3px;
}

/* ===== APP (hidden until login) ===== */
#appScreen{display:none;}

/* ===== HEADER ===== */
.header{
  background:linear-gradient(105deg,
    #6B0A1A 0%,
    #9B1B30 10%,
    #C1121F 20%,
    #A0245A 33%,
    #7B2D8B 46%,
    #4B2EA0 58%,
    #0077B6 72%,
    #0096C7 84%,
    #00B4D8 93%,
    #48CAE4 100%
  );
  color:white;padding:0;
  box-shadow:0 4px 24px rgba(0,0,0,0.35);
  position:relative;overflow:hidden;
}
.header::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(255,255,255,0.06) 0%,transparent 100%);
  pointer-events:none;
}
.header-inner{
  display:flex;align-items:stretch;justify-content:space-between;
  max-width:1200px;margin:0 auto;padding:0 24px;
}
.header-left{padding:16px 0;display:flex;align-items:center;gap:14px;}
.header-logo-wrap{
  width:58px;height:58px;
  border-radius:50%;background:white;
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;overflow:hidden;
  box-shadow:0 4px 16px rgba(0,0,0,0.3);
}
.header-logo-wrap img{width:100%;height:100%;object-fit:cover;border-radius:50%;}
.header-title h1{
  font-size:1.2rem;font-weight:900;line-height:1.2;
  text-shadow:0 2px 8px rgba(0,0,0,0.3);letter-spacing:-0.2px;
}
.header-title .simac{
  font-size:1.5rem;font-weight:900;letter-spacing:3px;
  display:block;line-height:1;
  text-shadow:0 2px 8px rgba(0,0,0,0.4);
}
.header-title p{font-size:0.68rem;font-weight:500;opacity:0.75;margin-top:3px;font-family:'Source Serif 4',serif;font-style:italic;}
.header-right{
  background:rgba(0,0,0,0.2);
  border-left:1px solid rgba(255,255,255,0.15);
  padding:14px 20px;
  display:flex;flex-direction:column;align-items:flex-end;justify-content:center;
  text-align:right;min-width:210px;
}
.header-right .ops-badge{font-size:0.6rem;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;opacity:0.65;margin-bottom:3px;}
.header-right .autor{font-size:0.9rem;font-weight:800;color:#FFE566;}
.header-right .autor-sub{font-size:0.68rem;opacity:0.65;font-family:'Source Serif 4',serif;font-style:italic;margin-top:1px;}
.header-right .version{font-size:0.6rem;opacity:0.45;margin-top:6px;letter-spacing:0.5px;}
.logout-btn{
  margin-top:10px;padding:5px 12px;
  background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.25);
  border-radius:20px;color:white;font-size:0.65rem;font-weight:600;
  cursor:pointer;letter-spacing:0.5px;text-transform:uppercase;
  transition:all 0.2s;font-family:'Montserrat',sans-serif;
}
.logout-btn:hover{background:rgba(255,255,255,0.25);}

/* ===== TABS ===== */
.tabs-bar{
  background:white;border-bottom:2px solid var(--gris-borde);
  box-shadow:0 2px 8px rgba(0,0,0,0.06);
}
.tabs-inner{
  max-width:1200px;margin:0 auto;
  display:flex;padding:0 16px;
}
.tab{
  padding:14px 22px;font-size:0.8rem;font-weight:700;
  color:var(--texto-suave);cursor:pointer;
  border-bottom:3px solid transparent;
  transition:all 0.2s;text-transform:uppercase;letter-spacing:0.4px;
  white-space:nowrap;user-select:none;
}
.tab:hover{color:var(--azul);}
.tab.active{color:var(--azul);border-bottom-color:var(--azul);}
.tab .tab-icon{margin-right:6px;font-size:0.85rem;}

/* ===== TAB CONTENT ===== */
.tab-panel{display:none;}
.tab-panel.active{display:block;}

/* ===== MAIN LAYOUT ===== */
.main{
  max-width:1200px;margin:24px auto;padding:0 16px 60px;
  display:grid;grid-template-columns:1fr 1fr;gap:18px;
}

/* ===== CARDS ===== */
.card{background:white;border-radius:16px;box-shadow:0 2px 12px rgba(0,0,0,0.07);overflow:hidden;}
.card.full{grid-column:1/-1;}
.card-header{display:flex;align-items:center;gap:10px;padding:14px 20px;border-bottom:2px solid var(--gris-bg);}
.card-icon{width:30px;height:30px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:0.9rem;flex-shrink:0;}
.card-header h2{font-size:0.85rem;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;}
.card-header .numero{margin-left:auto;font-size:0.62rem;font-weight:600;color:var(--texto-suave);background:var(--gris-bg);padding:2px 8px;border-radius:20px;}
.card-body{padding:18px;}

/* DATOS */
.card-header.datos{background:linear-gradient(90deg,#EFF6FF,#DBEAFE);}
.card-icon.datos{background:var(--azul);color:white;}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.form-group{display:flex;flex-direction:column;gap:4px;}
.form-group.span2{grid-column:1/-1;}
label{font-size:0.7rem;font-weight:600;color:var(--texto-suave);text-transform:uppercase;letter-spacing:0.4px;}
input,select,textarea{
  font-family:'Montserrat',sans-serif;font-size:0.83rem;
  padding:8px 11px;border:1.5px solid var(--gris-borde);
  border-radius:8px;color:var(--texto);background:white;
  transition:border-color 0.2s,box-shadow 0.2s;outline:none;
}
input:focus,select:focus,textarea:focus{border-color:var(--azul);box-shadow:0 0 0 3px rgba(0,119,182,0.1);}
textarea{resize:vertical;min-height:70px;}

/* CUADRO CLINICO */
.card-header.clinico{background:linear-gradient(90deg,#FFF7ED,#FFEDD5);}
.card-icon.clinico{background:var(--naranja);color:white;}
.sintomas-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:12px;}
.sintoma-item{
  display:flex;align-items:center;gap:7px;
  padding:7px 10px;border:1.5px solid var(--gris-borde);
  border-radius:7px;cursor:pointer;transition:all 0.18s;
  font-size:0.75rem;font-weight:500;user-select:none;
}
.sintoma-item:hover{border-color:var(--naranja);background:#FFF7ED;}
.sintoma-item.active{border-color:var(--naranja);background:#FFF7ED;}
.check-box{
  width:15px;height:15px;border:2px solid var(--gris-borde);
  border-radius:4px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  font-size:0.55rem;transition:all 0.18s;
}
.sintoma-item.active .check-box{background:var(--naranja);border-color:var(--naranja);color:white;}
.sintoma-item.alarma:hover{border-color:var(--rojo);background:#FFF1F2;}
.sintoma-item.alarma.active{border-color:var(--rojo);background:#FFF1F2;}
.sintoma-item.alarma.active .check-box{background:var(--rojo);border-color:var(--rojo);}
.sintoma-item.grave:hover{border-color:#7C3AED;background:#F5F3FF;}
.sintoma-item.grave.active{border-color:#7C3AED;background:#F5F3FF;}
.sintoma-item.grave.active .check-box{background:#7C3AED;border-color:#7C3AED;}
.sintoma-item.comorbilidad:hover{border-color:var(--verde);background:#F0FDF4;}
.sintoma-item.comorbilidad.active{border-color:var(--verde);background:#F0FDF4;}
.sintoma-item.comorbilidad.active .check-box{background:var(--verde);border-color:var(--verde);}
.section-subtitle{
  font-size:0.7rem;font-weight:700;color:var(--texto-suave);
  text-transform:uppercase;letter-spacing:0.5px;
  margin:12px 0 7px;padding-bottom:4px;border-bottom:1px solid var(--gris-borde);
}

/* EXAMENES */
.card-header.exam{background:linear-gradient(90deg,#F5F3FF,#EDE9FE);}
.card-icon.exam{background:#7C3AED;color:white;}
.exam-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.exam-group{
  background:var(--gris-bg);border-radius:10px;padding:12px 14px;
}
.exam-group-title{
  font-size:0.72rem;font-weight:700;text-transform:uppercase;
  letter-spacing:0.4px;margin-bottom:8px;padding-bottom:5px;
  border-bottom:1px solid var(--gris-borde);
}
.exam-item{
  display:flex;align-items:center;gap:8px;
  padding:5px 0;font-size:0.76rem;border-bottom:1px dashed #E2E8F0;cursor:pointer;
  user-select:none;transition:background 0.15s;
}
.exam-item:last-child{border-bottom:none;}
.exam-item:hover{color:var(--azul);}
.exam-check{
  width:14px;height:14px;border:2px solid var(--gris-borde);
  border-radius:3px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;font-size:0.5rem;
  transition:all 0.15s;
}
.exam-item.active .exam-check{background:#7C3AED;border-color:#7C3AED;color:white;}
.exam-nota{
  font-size:0.7rem;color:var(--texto-suave);
  background:#EDE9FE;border-left:3px solid #7C3AED;
  padding:6px 10px;border-radius:0 6px 6px 0;margin-top:10px;
  font-style:italic;
}

/* BOTON */
.btn-evaluar{
  grid-column:1/-1;display:flex;align-items:center;justify-content:center;gap:10px;
  width:100%;padding:14px;
  background:linear-gradient(135deg,#6B0A1A,#C1121F,#7B2D8B,#0077B6);
  color:white;border:none;border-radius:11px;
  font-family:'Montserrat',sans-serif;font-size:0.92rem;font-weight:700;
  letter-spacing:0.5px;cursor:pointer;transition:all 0.25s;
  box-shadow:0 4px 16px rgba(0,0,0,0.25);margin-top:6px;
}
.btn-evaluar:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,0.35);}

/* RESULTADOS */
.result-placeholder{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:32px 20px;text-align:center;gap:8px;color:var(--texto-suave);
}
.result-placeholder .icon{font-size:2.2rem;opacity:0.25;}
.result-placeholder p{font-size:0.78rem;max-width:200px;line-height:1.5;}
.result-content{padding:18px;}
.clasificacion-badge{
  display:inline-flex;align-items:center;gap:8px;
  padding:7px 14px;border-radius:28px;font-size:0.8rem;font-weight:700;margin-bottom:12px;
}
.badge-dssa{background:#DCFCE7;color:#166534;}
.badge-dcsa{background:#FEF9C3;color:#854D0E;}
.badge-dg{background:#FFE4E6;color:#9F1239;}
.result-section{margin-bottom:12px;}
.result-section-title{font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:var(--texto-suave);margin-bottom:5px;}
.result-item{display:flex;align-items:flex-start;gap:7px;padding:5px 0;font-size:0.78rem;line-height:1.4;border-bottom:1px dashed #E2E8F0;}
.result-item:last-child{border-bottom:none;}
.result-dot{width:5px;height:5px;border-radius:50%;margin-top:6px;flex-shrink:0;}
.trat-card{background:var(--gris-bg);border-radius:9px;padding:11px 13px;margin-bottom:9px;border-left:4px solid var(--azul);}
.trat-card.urgente{border-left-color:var(--rojo);background:#FFF1F2;}
.trat-card.advertencia{border-left-color:var(--naranja);background:#FFFBEB;}
.trat-card.verde{border-left-color:var(--verde);background:#F0FDF4;}
.trat-card.morado{border-left-color:#7C3AED;background:#F5F3FF;}
.trat-title{font-size:0.72rem;font-weight:700;margin-bottom:5px;text-transform:uppercase;letter-spacing:0.3px;}
.trat-body{font-size:0.76rem;line-height:1.6;color:#334155;}
.trat-body ul{padding-left:15px;}
.trat-body li{margin-bottom:2px;}
.alerta-box{
  display:flex;gap:10px;padding:9px 13px;border-radius:7px;
  font-size:0.76rem;line-height:1.4;margin-bottom:9px;
}
.alerta-box.rojo{background:#FFE4E6;border:1px solid #FECDD3;color:#9F1239;}
.alerta-box.amarillo{background:#FEF9C3;border:1px solid #FDE68A;color:#854D0E;}
.alerta-box.azul{background:#EFF6FF;border:1px solid #BFDBFE;color:#1E40AF;}
.card-header.dx{background:linear-gradient(90deg,#F0FDF4,#DCFCE7);}
.card-icon.dx{background:var(--verde);color:white;}
.card-header.tx{background:linear-gradient(90deg,#EFF6FF,#DBEAFE);}
.card-icon.tx{background:var(--azul-oscuro,#023E8A);color:white;}
.grupo-badge{font-size:0.68rem;font-weight:700;padding:2px 9px;border-radius:20px;background:var(--azul);color:white;margin-left:6px;}

/* ===== PLANTILLA TAB ===== */
.plantilla-main{max-width:1200px;margin:24px auto;padding:0 16px 60px;}
.plantilla-container{background:white;border-radius:16px;box-shadow:0 2px 12px rgba(0,0,0,0.07);overflow:hidden;}
.plantilla-header{
  padding:16px 24px;
  background:linear-gradient(105deg,#6B0A1A,#C1121F,#7B2D8B,#0077B6,#00B4D8);
  color:white;display:flex;align-items:center;justify-content:space-between;
}
.plantilla-header h2{font-size:1rem;font-weight:800;letter-spacing:0.5px;}
.plantilla-header p{font-size:0.72rem;opacity:0.75;margin-top:2px;}
.plantilla-actions{display:flex;gap:10px;}
.btn-copy,.btn-clear-pl{
  padding:8px 18px;border:none;border-radius:8px;
  font-family:'Montserrat',sans-serif;font-size:0.78rem;font-weight:700;
  cursor:pointer;transition:all 0.2s;
}
.btn-copy{background:var(--naranja-claro);color:#7C2D12;}
.btn-copy:hover{background:#FBBF24;}
.btn-clear-pl{background:rgba(255,255,255,0.15);color:white;border:1px solid rgba(255,255,255,0.25);}
.btn-clear-pl:hover{background:rgba(255,255,255,0.25);}
.plantilla-body{padding:24px;}
.plantilla-text{
  font-family:'Source Serif 4',serif;font-size:0.85rem;line-height:1.9;
  white-space:pre-wrap;color:var(--texto);
  background:#FAFAFA;border:1.5px solid var(--gris-borde);
  border-radius:10px;padding:20px;min-height:400px;
}
.plantilla-empty{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:80px 20px;text-align:center;gap:12px;color:var(--texto-suave);
}
.plantilla-empty .icon{font-size:3rem;opacity:0.2;}
.plantilla-empty p{font-size:0.85rem;max-width:320px;line-height:1.6;}
.copy-toast{
  position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(20px);
  background:#1E293B;color:white;padding:10px 24px;border-radius:30px;
  font-size:0.82rem;font-weight:600;opacity:0;
  transition:all 0.3s;pointer-events:none;z-index:9999;
}
.copy-toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

/* FOOTER */
.footer{
  text-align:center;padding:14px;font-size:0.65rem;color:var(--texto-suave);
  border-top:1px solid var(--gris-borde);background:white;
}

/* ANIMACION */
@keyframes fadeIn{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}
.animated{animation:fadeIn 0.35s ease;}

/* RESPONSIVE */
@media(max-width:720px){
  .main{grid-template-columns:1fr;}
  .card.full{grid-column:1;}
  .form-grid{grid-template-columns:1fr;}
  .sintomas-grid{grid-template-columns:1fr;}
  .exam-grid{grid-template-columns:1fr;}
  .header-right{display:none;}
  .tab{padding:12px 12px;font-size:0.7rem;}
  .tab .tab-icon{display:none;}
}
</style>
</head>
<body>

<!-- =================== LOGIN =================== -->
<div id="loginScreen">
  <div class="login-glow"></div>
  <div class="login-card">
    <div class="login-logo">
      <img id="loginLogoImg" src="" alt="SIMAC-D Logo">
    </div>
    <div class="login-app-name">SIMAC-D</div>
    <div class="login-app-subtitle">Sistema de Manejo Clínico del Dengue</div>

    <div id="loginError" class="login-error">Usuario o contraseña incorrectos</div>

    <div class="login-input-group">
      <input class="login-input" type="text" id="loginUser" placeholder="Usuario" autocomplete="username">
      <input class="login-input" type="password" id="loginPass" placeholder="Contraseña" autocomplete="current-password">
    </div>
    <button class="login-btn" onclick="doLogin()">INGRESAR AL SISTEMA</button>

    <div class="login-footer">
      <div class="login-footer-name">Dr. Rhonnie Duarte M.</div>
      <div class="login-footer-sub">Médico General · Autor del Sistema</div>
      <div class="login-footer-copy">© 2024 SIMAC-D · Todos los derechos reservados · Versión OPS/OMS 2020</div>
    </div>
  </div>
</div>

<!-- =================== APP =================== -->
<div id="appScreen">

<!-- HEADER -->
<div class="header">
  <div class="header-inner">
