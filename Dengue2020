    'TP / TPT (tiempo de coagulación)','Radiografía de tórax PA','Ecografía de tórax (derrame pleural)'];
  
  const grave = ['Gases arteriales / venosos','Lactato sérico','Troponina (si sospecha miocarditis)',
    'Fibrinógeno','Dímero D','TAC abdominal (si hemorragia)','Ecocardiograma (si miocarditis)',
    'Hemocultivo (descartar sepsis)','PCR / Procalcitonina'];

  const toActivate = clasificacion === 'DG' ? [...siempre, ...alarma, ...grave] :
                     clasificacion === 'DCSA' ? [...siempre, ...alarma] : siempre;

  examItems.forEach(item => {
    if(toActivate.some(t => item.querySelector('span').textContent.includes(t.split(' ')[0]))) {
      item.classList.add('active');
    }
  });

  const msg = clasificacion === 'DG'
    ? `🚨 <b>Dengue Grave:</b> Se han marcado todos los exámenes recomendados para dengue grave (hemograma, función hepática, coagulación, imágenes, marcadores virológicos y de UCI).`
    : clasificacion === 'DCSA'
      ? `⚠ <b>Dengue Con Signos de Alarma:</b> Se han marcado los exámenes recomendados incluyendo función hepática, coagulación e imágenes.`
      : `✅ <b>Dengue Sin Signos de Alarma:</b> Se recomienda hemograma, plaquetas y pruebas virológicas básicas.`;
  
  document.getElementById('examRecomendacion').innerHTML = msg;
  document.getElementById('examRecomendacion').className = `alerta-box ${clasificacion === 'DG' ? 'rojo' : clasificacion === 'DCSA' ? 'amarillo' : 'azul'}`;
}

// ===== EVALUAR =====
function evaluar() {
  const apellidos = document.getElementById('apellidos').value || '';
  const nombres = document.getElementById('nombres').value || '';
  const cedula = document.getElementById('cedula').value || '';
  const sexo = document.getElementById('sexo').value || '';
  const edad = parseInt(document.getElementById('edad').value) || 0;
  const peso = parseFloat(document.getElementById('peso').value) || 0;
  const diasFiebre = parseInt(document.getElementById('diasFiebre').value) || 0;
  const viaje = document.getElementById('viaje').value;
  const hto = document.getElementById('hematocrito').value;
  const plaquetas = document.getElementById('plaquetas').value;

  const sint = getSintomas();
  const esNino = edad > 0 && edad < 15;

  let clasificacion = 'DSSA', grupo = 'A';
  if (sint.grave.length > 0) { clasificacion = 'DG'; grupo = 'C'; }
  else if (sint.alarma.length > 0) { clasificacion = 'DCSA'; grupo = 'B2'; }
  else if (sint.comorbilidad.length > 0) { clasificacion = 'DSSA'; grupo = 'B1'; }
  else { clasificacion = 'DSSA'; grupo = 'A'; }

  window._clasificacion = clasificacion;
  window._grupo = grupo;
  window._sint = sint;
  window._datos = { apellidos, nombres, cedula, sexo, edad, peso, diasFiebre, viaje, hto, plaquetas, esNino };

  const dosisAcet = esNino && peso > 0 ? (peso*10)+'mg' : '500mg';
  const dosisMetamizol = esNino && peso > 0 ? (peso*10)+'mg' : '500mg';
  const volB2_1 = peso > 0 ? (peso*10).toFixed(0)+'ml' : '10ml/kg';
  const volB2_c = peso > 0 ? (peso*5).toFixed(0)+'ml' : '5ml/kg';
  const volC = peso > 0 ? (peso*20).toFixed(0)+'ml' : '20ml/kg';

  // ---- DIAGNOSTICO ----
  const nombre = [apellidos,nombres].filter(Boolean).join(' ') || 'Paciente';
  const badgeClass = clasificacion==='DSSA'?'badge-dssa':clasificacion==='DCSA'?'badge-dcsa':'badge-dg';
  const badgeLabel = clasificacion==='DSSA'?'🟢 Dengue Sin Signos de Alarma':clasificacion==='DCSA'?'🟡 Dengue Con Signos de Alarma':'🔴 Dengue Grave';

  let dxHTML = '<div class="result-content animated">';
  dxHTML += `<div class="clasificacion-badge ${badgeClass}">${badgeLabel}<span class="grupo-badge">Grupo ${grupo}</span></div>`;
  
  dxHTML += `<div class="result-section"><div class="result-section-title">Datos del Paciente</div>`;
  if(nombre!='Paciente') dxHTML+=`<div class="result-item"><div class="result-dot" style="background:var(--azul)"></div><b>${nombre}</b>${cedula?` — CI: ${cedula}`:''}</div>`;
  if(edad) dxHTML+=`<div class="result-item"><div class="result-dot" style="background:var(--azul)"></div>${edad} años${sexo?` · ${sexo}`:''}</div>`;
  if(diasFiebre) dxHTML+=`<div class="result-item"><div class="result-dot" style="background:var(--naranja)"></div>Fiebre de <b>${diasFiebre} días</b> de evolución</div>`;
  if(peso) dxHTML+=`<div class="result-item"><div class="result-dot" style="background:var(--azul)"></div>Peso: <b>${peso} kg</b></div>`;
  if(hto) dxHTML+=`<div class="result-item"><div class="result-dot" style="background:var(--rojo)"></div>Hematocrito: <b>${hto}%</b></div>`;
  if(plaquetas) dxHTML+=`<div class="result-item"><div class="result-dot" style="background:var(--rojo)"></div>Plaquetas: <b>${plaquetas}×10³</b></div>`;
  dxHTML+=`</div>`;

  const generalesItems = document.querySelectorAll('.sintoma-item:not(.alarma):not(.grave):not(.comorbilidad).active');
  if(generalesItems.length>0||sint.alarma.length>0||sint.grave.length>0||sint.comorbilidad.length>0){
    dxHTML+=`<div class="result-section"><div class="result-section-title">Hallazgos Clínicos</div>`;
    generalesItems.forEach(i=>{ dxHTML+=`<div class="result-item"><div class="result-dot" style="background:var(--verde-claro)"></div>${i.querySelector('span').textContent}</div>`; });
    sint.alarma.forEach(s=>{ dxHTML+=`<div class="result-item"><div class="result-dot" style="background:var(--rojo)"></div>⚠ ${s}</div>`; });
    sint.grave.forEach(s=>{ dxHTML+=`<div class="result-item"><div class="result-dot" style="background:#7C3AED"></div>🚨 ${s}</div>`; });
    sint.comorbilidad.forEach(s=>{ dxHTML+=`<div class="result-item"><div class="result-dot" style="background:var(--verde)"></div>+ ${s}</div>`; });
    dxHTML+=`</div>`;
  }

  const hospitRec = clasificacion!=='DSSA'||sint.comorbilidad.length>0;
  if(clasificacion==='DG') dxHTML+=`<div class="alerta-box rojo">🚨 HOSPITALIZACIÓN URGENTE EN UCI</div>`;
  else if(clasificacion==='DCSA') dxHTML+=`<div class="alerta-box amarillo">⚠ Hospitalización en unidad de dengue requerida</div>`;
  else if(grupo==='B1') dxHTML+=`<div class="alerta-box amarillo">📋 Posible remisión a unidad de dengue para observación</div>`;
  else dxHTML+=`<div class="alerta-box azul">✅ Manejo ambulatorio con monitoreo cada 24–48h</div>`;

  // CIE-10
  const cie10 = clasificacion==='DG'?'A97.2 — Dengue grave':clasificacion==='DCSA'?'A97.1 — Dengue con signos de alarma':'A97.0 — Dengue sin signos de alarma';
  dxHTML+=`<div class="trat-card morado"><div class="trat-title">📋 CIE-10</div><div class="trat-body"><b>${cie10}</b></div></div>`;
  dxHTML+=`<div class="result-section"><div class="result-section-title">Diagnóstico diferencial a considerar</div>
    <div class="result-item"><div class="result-dot" style="background:var(--texto-suave)"></div>COVID-19 · Zika · Chikungunya · Influenza</div>
    <div class="result-item"><div class="result-dot" style="background:var(--texto-suave)"></div>Sarampión · Rubéola · Rickettsiosis · Paludismo</div>
    <div class="result-item"><div class="result-dot" style="background:var(--texto-suave)"></div>Leptospirosis · Hepatitis viral · Fiebre tifoidea</div>
  </div>`;
  dxHTML+='</div>';
  document.getElementById('dxContent').innerHTML = dxHTML;

  // ---- TRATAMIENTO ----
  let txHTML = '<div class="result-content animated">';
  if(clasificacion==='DSSA'&&grupo==='A'){
    txHTML+=`<div class="trat-card verde"><div class="trat-title">🏠 Grupo A — Tratamiento en el Hogar</div><div class="trat-body"><ul>
      <li>Reposo absoluto en cama</li><li>Dieta normal + abundantes líquidos orales / SRO</li>
      <li>Lienzos de agua tibia en frente</li><li>Educar sobre signos de alarma</li>
    </ul></div></div>`;
    txHTML+=`<div class="trat-card"><div class="trat-title">💊 Antipirético</div><div class="trat-body">
      ${esNino?`<b>Niño:</b> Acetaminofén V.O <b>${dosisAcet}</b> cada 6h<br>o Metamizol V.O <b>${dosisMetamizol}</b> cada 6h`
              :`<b>Adulto:</b> Acetaminofén V.O <b>500mg</b> cada 6h<br>o Metamizol V.O <b>500mg</b> cada 6h`}
      <br><b style="color:var(--rojo)">❌ NO: AINEs, aspirina, ibuprofeno, corticoides</b>
    </div></div>`;
    txHTML+=`<div class="trat-card advertencia"><div class="trat-title">📅 Monitoreo</div><div class="trat-body">
      Control cada <b>24–48 horas</b> hasta 48h después del descenso de fiebre sin antipiréticos.
    </div></div>`;
  } else if(clasificacion==='DSSA'&&grupo==='B1'){
    txHTML+=`<div class="trat-card advertencia"><div class="trat-title">🏥 Grupo B1 — Remisión a Unidad de Dengue</div><div class="trat-body"><ul>
      <li>Vigilar signos de alarma continuamente</li>
      <li>Valoración binomio madre/hijo en gestantes</li>
      <li>Estabilizar y manejar comorbilidades</li>
      <li>Curva febril y balance de líquidos</li>
      <li>Estimular ingesta de líquidos V.O</li>
    </ul></div></div>`;
    txHTML+=`<div class="trat-card"><div class="trat-title">💊 Antipirético</div><div class="trat-body">
      ${esNino?`Acetaminofén V.O <b>${dosisAcet}</b> cada 6h o Metamizol V.O <b>${dosisMetamizol}</b> cada 6h`
              :`Acetaminofén V.O <b>500mg</b> cada 6h o Metamizol V.O <b>500mg</b> cada 6h`}
      <br><b style="color:var(--rojo)">❌ NO: AINEs, aspirina, corticoides</b>
    </div></div>`;
    txHTML+=`<div class="trat-card verde"><div class="trat-title">💧 Líquidos IV (si intolerancia oral)</div><div class="trat-body">
      Lactato de Ringer o SSN 0.9%<br>
      ${esNino?'Fórmula Holliday-Segar (pediátrico)':`2–4 ml/kg/h${peso?` = ${(peso*3).toFixed(0)}ml/h`:''}`}
    </div></div>`;
  } else if(clasificacion==='DCSA'){
    const comorb = sint.comorbilidad.length>0||edad>=65;
    txHTML+=`<div class="trat-card urgente"><div class="trat-title">🏥 Grupo B2 — Hospitalización</div><div class="trat-body">
      Remisión inmediata a hospital o unidad de dengue. Requiere líquidos IV y monitoreo horario.
    </div></div>`;
    if(comorb){
      txHTML+=`<div class="trat-card"><div class="trat-title">💧 Líquidos IV — DCSA + Comorbilidad/Adulto Mayor</div><div class="trat-body">
        <b>1ª carga:</b> Cristaloide 5ml/kg en 1h${peso?` = <b>${volB2_c}</b>`:''}<br>
        ✔ Mejoría → 4ml/kg/h×2-4h → 3ml/kg/h×2-4h → 2ml/kg/h×2-4h<br>
        ✘ Sin mejoría → repetir hasta 3 cargas de 5ml/kg<br>
        ✘ Sin respuesta → clasificar como <b>Dengue Grave (Grupo C)</b>
      </div></div>`;
    } else {
      txHTML+=`<div class="trat-card"><div class="trat-title">💧 Líquidos IV — Protocolo DCSA</div><div class="trat-body">
        <b>1ª carga:</b> Cristaloide 10ml/kg en 1h${peso?` = <b>${volB2_1}</b>`:''}<br>
        ✔ Mejoría → 5-7ml/kg/h×2-4h → 3-5ml/kg/h×2-4h → 2-4ml/kg/h×24-48h<br>
        ✘ Sin mejoría → repetir hasta 3 cargas de 10ml/kg<br>
        ✘ Sin respuesta → clasificar como <b>Dengue Grave (Grupo C)</b>
      </div></div>`;
    }
  } else if(clasificacion==='DG'){
    txHTML+=`<div class="trat-card urgente"><div class="trat-title">🚨 Grupo C — UCI · URGENCIA MÁXIMA</div><div class="trat-body">
      ABC + Oxigenoterapia. Monitoreo cada 5–30 min.
    </div></div>`;
    txHTML+=`<div class="trat-card urgente"><div class="trat-title">💧 Reposición — Choque Hipovolémico</div><div class="trat-body">
      <b>Bolo 1:</b> Cristaloide 20ml/kg en 15-30min${peso?` = <b>${volC}</b>`:''}<br>
      ✔ Mejoría → 10ml/kg/h×1-2h → 5-7ml/kg/h×4-6h → 3-5ml/kg/h×2-4h → 2-4ml/kg/h×24-48h<br>
      ✘ Sin mejoría → 2º bolo → 3º bolo → medidas avanzadas UCI
    </div></div>`;
    txHTML+=`<div class="trat-card advertencia"><div class="trat-title">🔴 Choque Persistente</div><div class="trat-body"><ul>
      <li>Función de bomba y aminas vasoactivas</li>
      <li>Evaluar acidosis y hemorragia oculta</li>
      <li>Considerar coloide si no responde a cristaloides</li>
      <li>Manejo en UCI obligatorio</li>
    </ul></div></div>`;
  }

  txHTML+=`<div class="trat-card verde"><div class="trat-title">🏠 Criterios de Alta</div><div class="trat-body">
    <b>Clínicos:</b> Afebril ≥48h sin antipiréticos · Mejoría general · Hemodinamia normal · Sin sangrado<br>
    <b>Lab:</b> Plaquetas en ascenso · Hematocrito estable sin IV
  </div></div>`;
  txHTML+='</div>';
  document.getElementById('txContent').innerHTML = txHTML;

  actualizarExamenes(clasificacion);

  setTimeout(()=>{ document.getElementById('cardDx').scrollIntoView({behavior:'smooth',block:'start'}); },100);
}

function getSintomas() {
  const items = document.querySelectorAll('.sintoma-item');
  const r = {generales:0,alarma:[],grave:[],comorbilidad:[]};
  items.forEach(item=>{
    if(!item.classList.contains('active')) return;
    const txt = item.querySelector('span').textContent;
    if(item.classList.contains('alarma')) r.alarma.push(txt);
    else if(item.classList.contains('grave')) r.grave.push(txt);
    else if(item.classList.contains('comorbilidad')) r.comorbilidad.push(txt);
    else r.generales++;
  });
  return r;
}

